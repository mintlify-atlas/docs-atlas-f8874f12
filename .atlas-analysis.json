  "keyFeatures": [
    "File-based routing with static and dynamic segments",
    "Server-Side Rendering (SSR) with React 19 and Vite 8",
    "Static Site Generation (SSG) via generateStaticParams",
    "File-based API routes with end-to-end TypeScript types via createHandler and $fetch",
    "Nested layouts with parallel loader execution",
    "Route guards for server-side redirects before rendering",
    "SEO metadata with Open Graph, Twitter Card, and dynamic generation",
    "Typed navigation hooks: useNavigate, useRevalidate with View Transitions API support",
    "Context hooks: useRequest, useCtx, useParams for handler-scoped access",
    "API middleware per directory"
  ],
